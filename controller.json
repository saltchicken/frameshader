{
  "video_input": "/home/saltchicken/Projects/frameshader-rs/videos/forest_video.mp4",

  "active_preset": "geo_kaleido",

  "presets": {
    "trippy_vortex": [
      {
        "name": "warp/vortex",
        "params": {
          "sensitivity": 0.2,
          "vortex_radius": 1.5,
          "spin_speed": -0.1
        }
      }
    ],
    "geo_kaleido": [
      {
        "name": "warp/kaleido",
        "params": {
          "segments": 40.0,
          "spin_speed": -0.1
        }
      },
      {
        "name": "geo/topography",
        "params": {
          "sensitivity": 1.0
        }
      }
    ],
    "ascii_edge": [
    {
      "name": "ascii/audio_react",
      "params": {
        "sensitivity": 1.0,
        "bass_gain": 0.5,
        "mid_gain": 0.2,
        "treble_gain": 0.8,
        "vol_gain": 1.5,
        "noise_gate": 0.15
      }
    },
          {
      "name": "filters/edge",
      "params": {
        "sensitivity": 1.2
      }
    },


    ]
  },

  "pipeline": [
    {
      "name": "ascii/matrix/matrix",
      "params": {
        "sensitivity": 1.0,
        "bass_gain": 0.5,
        "mid_gain": 0.2,
        "treble_gain": 0.8,
        "vol_gain": 1.5,
        "noise_gate": 0.15
      }
    },
  ],

  // Globals are fallback uniforms if a stage doesn't define them in 'params'
  "globals": {
    "rain_speed": 0.2,       // Used by all matrix shaders
    "tail_length": 1.5,      // Used by all matrix shaders
    // "flicker_speed": 10.0,    // Only used by ascii/matrix/flux
    "font_width": 2.0,
    "font_height": 4.0,
    "num_chars": 20.0
  },

  // Adjust to hide messy video edges (0.0 to 0.49)
  "crop": {
    "left": 0.0,
    "right": 0.0,
    "top": 0.0,
    "bottom": 0.0
  },
  
  // Sync timing
  "playback_fps": 30.0,
  "bpm_multiplier": 14.0,

  "audio": {
    // FFT Configuration (Assuming 44.1kHz sample rate & 512 buffer = ~86Hz per bin)
    "bass_bin_start": 1,     // ~86 Hz
    "bass_bin_end": 3,       // ~258 Hz
    "mid_bin_start": 6,      // ~516 Hz
    "mid_bin_end": 22,       // ~1892 Hz
    "treble_bin_start": 23,  // ~1978 Hz
    "treble_bin_end": 100,   // ~8600 Hz
    
    // Temporal smoothing for audio reactivity
    "smoothing_old": 0.7,    // Weight of previous frame
    "smoothing_new": 0.3,    // Weight of current frame
    
    // Normalization factors (Higher = less reactive to that frequency band)
    "bass_norm_factor": 84.0,
    "mid_norm_factor": 290.0,
    "treble_norm_factor": 600.0,
    "volume_norm_factor": 500.0
  }
}
